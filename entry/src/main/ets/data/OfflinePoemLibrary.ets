export function getOfflinePoemById(poemId: string): OfflinePoem {
  const found = OFFLINE_POEMS.find((item: OfflinePoem) => item.id === poemId);
  return found ?? OFFLINE_POEMS[0];
}

export function getOfflinePoemTitle(poemId: string): string {
  return getOfflinePoemById(poemId).title;
}

export function getOfflineCategoryById(categoryId: string): OfflinePoemCategory | undefined {
  return OFFLINE_POEM_CATEGORIES.find((item: OfflinePoemCategory) => item.id === categoryId);
}

export function getOfflinePoemsByCategory(categoryId: string): OfflinePoem[] {
  return OFFLINE_POEMS.filter((item: OfflinePoem) => item.categories.includes(categoryId));
}

export function searchOfflinePoems(keyword: string): OfflinePoem[] {
  const normalized = keyword.trim().toLowerCase();
  if (normalized.length === 0) {
    return OFFLINE_POEMS;
  }
  return OFFLINE_POEMS.filter((item: OfflinePoem) => item.searchableText.toLowerCase().includes(normalized));
}

export function getRecommendedPoems(): OfflinePoem[] {
  return [
    getOfflinePoemById('chunxiao'),
    getOfflinePoemById('jingyesi'),
    getOfflinePoemById('dengguanquelou'),
    getOfflinePoemById('wanglushanpubu'),
    getOfflinePoemById('yonge'),
    getOfflinePoemById('xiaochi')
  ];
}
